{
  "manifest_version": 3,
  "name": "S.O.G. Battle — Voice Commands",
  "version": "1.0.0",
  "description": "Comandos de voz para narração de partidas S.O.G. Battle",
  "permissions": [],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["audio/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "sog-voice@example.com",
      "strict_min_version": "112.0"
    }
  }
}
